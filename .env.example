# CloudPanel production configuration
NODE_ENV=production
PORT=3000
APP_URL=https://my.beykoz.edu.tr/pdf
# REQUIRED: generate a unique value with: openssl rand -base64 48
SESSION_SECRET=
REDIS_URL=redis://127.0.0.1:6379/0
TRUST_PROXY_HOPS=1

# Google Workspace > Apps > Web and mobile apps > PDF Düzenle
# Leave BOTH empty until Google is configured: the landing page works,
# and the workspace stays inaccessible. Fill all three together later.
SAML_ENTRY_POINT=
SAML_IDP_ISSUER=
# Download Google's PUBLIC X.509 certificate and put it in this PEM file.
SAML_IDP_CERT_PATH=./certs/google-workspace.pem
SAML_SP_ENTITY_ID=https://my.beykoz.edu.tr/pdf/auth/saml/metadata
