{
  "name": "beykoz-pdf-duzenle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:php": "node scripts/package-php.mjs",
    "test": "node --test tests/php.test.mjs tests/cloudflare.test.mjs",
    "test:e2e": "playwright test",
    "install:engine": "npm ci --prefix engine --ignore-scripts",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "build:cloudflare": "npm run install:engine && PDF_TARGET=cloudflare node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "xml-crypto": "6.1.2"
  }
}
